{
  "name": "mock-stride",
  "private": true,
  "version": "0.1.0",
  "description": "Stand-in for the Stride EHR: creates Stride-format CSV exports and uploads them to our SFTP server for end-to-end testing.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "timer": "node scripts/timer.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.27",
    "postgres": "3.4.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "ssh2-sftp-client": "12.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/ssh2-sftp-client": "9.0.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
