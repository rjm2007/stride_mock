# Demo database connection string (the same database the backend's demo .env uses).
DATABASE_URL=
# "disable" only for the demo server's own db container (no TLS inside Docker); default require.
DATABASE_SSL=require
# "true" only for a direct Postgres connection; Supabase's transaction pooler needs it off.
DATABASE_PREPARE=false
# Password for the web app (Basic auth; any username).
MOCK_STRIDE_PASSWORD=
# Shared secret the 5-minute timer sends as "Authorization: Bearer <secret>".
CRON_SECRET=
# Our SFTP server (the same login Stride will use, with our own test key).
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=stride
SFTP_DIR=/incoming
# OpenSSH private key, newlines as \n when stored in one line.
SFTP_PRIVATE_KEY=
# Optional: SHA256 fingerprint of the server host key (base64, as ssh-keygen -lf prints after "SHA256:").
SFTP_HOST_FINGERPRINT=
# Clinic timezone used for "today" and appointment times.
CLINIC_TIMEZONE=America/New_York
